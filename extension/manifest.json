{
  "manifest_version": 3,
  "name": "Downloader for Rule 34",
  "description": "Side-panel batch downloader for rule34video.com and rule34.world: playlists, searches, homepages, multi-page crawls, pictures and videos.",
  "version": "6.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "sidePanel",
    "notifications",
    "contextMenus",
    "tabs",
    "scripting",
    "offscreen",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://rule34.world/*",
    "https://*.rule34.world/*",
    "http://rule34.world/*",
    "http://*.rule34.world/*",
    "https://www.rule34.world/*",
    "http://www.rule34.world/*",
    "https://rule34storage.b-cdn.net/*",
    "https://rule34video.com/*",
    "https://*.rule34video.com/*",
    "http://rule34video.com/*",
    "http://*.rule34video.com/*"
  ],
  "background": {
    "service_worker": "background-enhanced.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rule34video.com/*",
        "https://*.rule34video.com/*",
        "http://rule34video.com/*",
        "http://*.rule34video.com/*"
      ],
      "js": [
        "site-routes.js",
        "content-rule34video.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rule34.world/*",
        "https://*.rule34.world/*",
        "http://rule34.world/*",
        "http://*.rule34.world/*",
        "https://www.rule34.world/*",
        "http://www.rule34.world/*"
      ],
      "js": [
        "site-routes.js",
        "content-rule34world.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Rule 34 Downloader — open the download panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';"
  }
}
